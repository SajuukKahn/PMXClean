<Window
    x:Class="PMXClean.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:PMXClean.Behaviors"
    xmlns:converters="clr-namespace:PMXClean.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PMXClean"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PMXClean.ViewModels"
    Title="PathMaster X Utility Tool"
    Width="1000"
    Height="760"
    MinWidth="800"
    MinHeight="600"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    WindowStyle="ThreeDBorderWindow"
    mc:Ignorable="d">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header with Path Selection  -->
        <materialDesign:ColorZone
            Grid.Row="0"
            Padding="16"
            AllowDrop="True"
            Drop="ColorZone_Drop"
            Mode="SecondaryDark">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    Margin="0,0,8,0"
                    materialDesign:HintAssist.Hint="{Binding FileVersionText}"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding Installations}"
                    SelectedItem="{Binding SelectedInstallation}"
                    Style="{StaticResource MaterialDesignFilledComboBox}" />

                <!--  Backup Indicators (Full Backup / Custom DLLs)  -->
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Orientation="Horizontal"
                    Visibility="{Binding SelectedInstallation.IsBackup, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">

                    <!--  Full Backup Badge  -->
                    <Border
                        Margin="0,0,8,0"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Background="#2E7D32"
                        CornerRadius="4"
                        Visibility="{Binding SelectedInstallation.IsFullBackup, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Kind="DatabaseCheck" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="White"
                                Text="Full Backup" />
                        </StackPanel>
                    </Border>

                    <!--  Custom DLLs Warning  -->
                    <Border
                        Margin="0,0,8,0"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Background="#F57C00"
                        CornerRadius="4"
                        ToolTip="{Binding SelectedInstallation.BackupInfo.CustomDlls, Converter={x:Static converters:ListToStringConverter.Instance}}"
                        Visibility="{Binding SelectedInstallation.HasCustomDlls, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Kind="FileCodeOutline" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="White"
                                Text="Custom DLLs" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Locked Files Indicator  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="{Binding LockedFileCount, Converter={x:Static converters:NotZeroToVisibilityConverter.Instance}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="Gold"
                            Kind="Lock" />
                        <TextBlock VerticalAlignment="Center" FontWeight="Medium">
                            <Run Text="Locked Files Detected:" />
                            <Run FontWeight="Bold" Text="{Binding LockedFileCount, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <WrapPanel Grid.Column="3" VerticalAlignment="Center">
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding LoadMachineBackupCommand}"
                        Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                        ToolTip="Load .machine backup file (or drag &amp; drop)">
                        <materialDesign:PackIcon Kind="FileUpload" />
                    </Button>
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding UnloadMachineBackupCommand}"
                        Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryLightButton}"
                        ToolTip="Unload machine backup"
                        Visibility="{Binding IsBackupLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <materialDesign:PackIcon Kind="FileRemove" />
                    </Button>
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding OpenTargetFolderCommand}"
                        Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                        ToolTip="Open target installation folder in File Explorer">
                        <materialDesign:PackIcon Kind="FolderOpen" />
                    </Button>
                    <Button
                        Command="{Binding RefreshPathsCommand}"
                        Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                        ToolTip="Refresh installation paths">
                        <materialDesign:PackIcon Kind="Refresh" />
                    </Button>
                </WrapPanel>

            </Grid>
        </materialDesign:ColorZone>

        <!--  Main Content - Tabs  -->
        <TabControl
            Grid.Row="1"
            Margin="0,0,0,0"
            Style="{StaticResource MaterialDesignTabControl}">

            <!--  Compare Python Tab  -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="CodeBraces" />
                        <TextBlock Text="Compare Python" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Comparison Setup Card  -->
                    <materialDesign:Card
                        Grid.Row="0"
                        Margin="8"
                        Padding="16,8,16,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Version Selection  -->
                            <ComboBox
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                materialDesign:HintAssist.Hint="Compare Against Version"
                                materialDesign:HintAssist.IsFloating="True"
                                ItemsSource="{Binding AvailableVersions}"
                                SelectedItem="{Binding SelectedVersion}"
                                Style="{StaticResource MaterialDesignFilledComboBox}" />

                            <Button
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                Command="{Binding AutoMatchVersionCommand}"
                                Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                ToolTip="Auto-select version matching the target installation">
                                <materialDesign:PackIcon Kind="AutoFix" />
                            </Button>

                            <!--  Compare Button  -->
                            <Button
                                Grid.Column="2"
                                Margin="0,0,8,0"
                                Command="{Binding ComparisonViewModel.CompareCommand}"
                                IsEnabled="{Binding SelectedVersion, Converter={x:Static converters:NotNullToBoolConverter.Instance}}"
                                Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                ToolTip="Compare Files">
                                <materialDesign:PackIcon Kind="Compare" />
                            </Button>

                            <Button
                                Grid.Column="3"
                                Height="40"
                                Margin="0,0,8,0"
                                Command="{Binding CloseComparisonCommand}"
                                IsEnabled="{Binding IsComparisonVisible}"
                                Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryButton}"
                                ToolTip="Close comparison and view locked files">
                                <materialDesign:PackIcon Kind="Close" />
                            </Button>

                            <CheckBox
                                Grid.Column="4"
                                Margin="0,0,8,0"
                                Content="Differences Only"
                                IsChecked="{Binding ComparisonViewModel.ShowOnlyDifferences}" />


                            <!--  Status  -->
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Margin="0,8,0,0"
                                Opacity="0.7"
                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                Text="{Binding ComparisonViewModel.StatusMessage}" />


                            <Grid
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="5"
                                Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  Left Backup  -->
                                <Border
                                    Grid.Column="0"
                                    Margin="0,0,4,0"
                                    Padding="8"
                                    AllowDrop="True"
                                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                    BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Drop="LeftBackupDrop_Drop">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontWeight="Medium" Text="Left Backup" />
                                            <TextBlock
                                                Opacity="0.7"
                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                Text="{Binding ComparisonViewModel.LeftBackup.DisplayName, FallbackValue='Drop or click to load'}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Command="{Binding ComparisonViewModel.LoadLeftBackupCommand}"
                                            Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                            ToolTip="Load left backup">
                                            <materialDesign:PackIcon Kind="FileUpload" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!--  Swap Button  -->
                                <Button
                                    Grid.Column="1"
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding ComparisonViewModel.SwapBackupsCommand}"
                                    Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                    ToolTip="Swap left and right">
                                    <materialDesign:PackIcon Kind="SwapHorizontal" />
                                </Button>

                                <!--  Right Backup  -->
                                <Border
                                    Grid.Column="2"
                                    Margin="4,0,0,0"
                                    Padding="8"
                                    AllowDrop="True"
                                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                    BorderBrush="{DynamicResource MaterialDesign.Brush.Secondary}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Drop="RightBackupDrop_Drop">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontWeight="Medium" Text="Right Backup" />
                                            <TextBlock
                                                Opacity="0.7"
                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                Text="{Binding ComparisonViewModel.RightBackup.DisplayName, FallbackValue='Drop or click to load'}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Command="{Binding ComparisonViewModel.LoadRightBackupCommand}"
                                            Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                            ToolTip="Load right backup">
                                            <materialDesign:PackIcon Kind="FileUpload" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!--  Action Buttons  -->
                                <StackPanel
                                    Grid.Column="3"
                                    Margin="8,0,0,0"
                                    Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,4,0"
                                        Command="{Binding ComparisonViewModel.CompareBackupsCommand}"
                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                        ToolTip="Compare the two backups">
                                        <materialDesign:PackIcon Kind="Compare" />
                                    </Button>
                                    <Button
                                        Command="{Binding ComparisonViewModel.ClearBackupsCommand}"
                                        Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryButton}"
                                        ToolTip="Clear both backups">
                                        <materialDesign:PackIcon Kind="Close" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>

                    <!--  Main Comparison Area  -->
                    <Grid
                        Grid.Row="1"
                        Margin="8"
                        Visibility="{Binding IsComparisonVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="250" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2*" MinWidth="400" />
                        </Grid.ColumnDefinitions>

                        <!--  File Tree  -->
                        <materialDesign:Card Grid.Column="0" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  Tree Header  -->
                                <Border Grid.Row="0" Background="{DynamicResource MaterialDesign.Brush.Primary}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            FontWeight="Medium"
                                            Foreground="White"
                                            Text="{Binding ComparisonViewModel.LeftLabel}" />


                                        <Button
                                            Grid.Column="1"
                                            Height="24"
                                            Margin="0,4,4,4"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding ComparisonViewModel.ExpandDifferencesOnlyCommand}"
                                            Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                                            ToolTip="Expand folders with differences">
                                            <materialDesign:PackIcon Kind="UnfoldMoreHorizontal" />
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            Height="24"
                                            Margin="4,4,0,4"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding ComparisonViewModel.CollapseAllCommand}"
                                            Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                                            ToolTip="Collapse all folders">
                                            <materialDesign:PackIcon Kind="UnfoldLessHorizontal" />
                                        </Button>

                                        <TextBlock
                                            Grid.Column="3"
                                            Margin="0,0,4,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontWeight="Medium"
                                            Foreground="White"
                                            Text="{Binding ComparisonViewModel.RightLabel}" />
                                    </Grid>
                                </Border>

                                <!--  File Tree View  -->
                                <TreeView
                                    x:Name="ComparisonTreeView"
                                    Grid.Row="1"
                                    ItemsSource="{Binding ComparisonViewModel.ComparisonItems}"
                                    VirtualizingStackPanel.IsVirtualizing="False">
                                    <TreeView.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource MaterialDesignTreeViewItem}" TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <Grid
                                                Margin="2"
                                                Background="Transparent"
                                                ToolTip="{Binding RelativePath}">
                                                <Grid.InputBindings>
                                                    <MouseBinding
                                                        Command="{Binding DataContext.SelectComparisonItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        MouseAction="LeftClick" />
                                                </Grid.InputBindings>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!--  Status Icon  -->
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="18"
                                                    Height="18"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                    <Setter Property="Kind" Value="Folder" />
                                                                    <Setter Property="Foreground" Value="Green" />
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsFolder}" Value="True" />
                                                                        <Condition Binding="{Binding Status}" Value="ContainsDifferences" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Foreground" Value="Orange" />
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsFolder}" Value="False" />
                                                                        <Condition Binding="{Binding IsPythonScript}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Kind" Value="LanguagePython" />
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsFolder}" Value="False" />
                                                                        <Condition Binding="{Binding IsPythonScript}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Kind" Value="File" />
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsFolder}" Value="False" />
                                                                        <Condition Binding="{Binding Status}" Value="Same" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Foreground" Value="Green" />
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsFolder}" Value="False" />
                                                                        <Condition Binding="{Binding Status}" Value="Different" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Foreground" Value="Orange" />
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsFolder}" Value="False" />
                                                                        <Condition Binding="{Binding Status}" Value="LeftOnly" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Foreground" Value="Red" />
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsFolder}" Value="False" />
                                                                        <Condition Binding="{Binding Status}" Value="RightOnly" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Foreground" Value="DodgerBlue" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>

                                                <!--  Lock Icon (Left)  -->
                                                <materialDesign:PackIcon
                                                    Grid.Column="1"
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,2,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="Gold"
                                                    Kind="Lock"
                                                    ToolTip="Source file is locked (#lock)"
                                                    Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                <!--  Lock Icon (Right)  -->
                                                <materialDesign:PackIcon
                                                    Grid.Column="2"
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="Orange"
                                                    Kind="LockOpen"
                                                    ToolTip="Target file is locked (#lock)"
                                                    Visibility="{Binding IsLockedRight, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                <!--  File Name  -->
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Name}">
                                                    <TextBlock.Style>
                                                        <Style BasedOn="{StaticResource MaterialDesignBody2TextBlock}" TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Different">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="LeftOnly">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                    <Setter Property="Foreground" Value="Red" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="RightOnly">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                    <Setter Property="Foreground" Value="DodgerBlue" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Grid>
                        </materialDesign:Card>

                        <GridSplitter
                            Grid.Column="1"
                            Width="10"
                            HorizontalAlignment="Center"
                            ResizeBehavior="PreviousAndNext" />

                        <!--  Diff Viewer  -->
                        <materialDesign:Card Grid.Column="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  Diff Header  -->
                                <Border
                                    Grid.Row="0"
                                    Padding="12,8"
                                    Background="{DynamicResource MaterialDesign.Brush.Primary}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontWeight="Medium"
                                            Foreground="White"
                                            Text="{Binding ComparisonViewModel.CurrentFileComparison.RelativePath, FallbackValue='Select a file to compare'}" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Visibility="{Binding ComparisonViewModel.CurrentFileComparison, Converter={x:Static converters:NotNullToVisibilityConverter.Instance}}">
                                            <TextBlock
                                                Margin="8,0"
                                                Foreground="LightGreen"
                                                Text="{Binding ComparisonViewModel.CurrentFileComparison.AddedLines, StringFormat='+{0}'}" />
                                            <TextBlock
                                                Margin="8,0"
                                                Foreground="LightCoral"
                                                Text="{Binding ComparisonViewModel.CurrentFileComparison.RemovedLines, StringFormat='-{0}'}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!--  Diff Content  -->
                                <ScrollViewer
                                    Grid.Row="1"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ComparisonViewModel.CurrentFileComparison.DiffLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="20">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="45" />
                                                        <ColumnDefinition Width="45" />
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Added">
                                                                    <Setter Property="Background" Value="#1A4CAF50" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Removed">
                                                                    <Setter Property="Background" Value="#1AF44336" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>

                                                    <!--  Left Line Number  -->
                                                    <Border
                                                        Grid.Column="0"
                                                        BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                                                        BorderThickness="0,0,1,0">
                                                        <TextBlock
                                                            Margin="4,0"
                                                            HorizontalAlignment="Right"
                                                            FontFamily="Consolas"
                                                            FontSize="11"
                                                            Foreground="Gray"
                                                            Text="{Binding LeftLineNumber}" />
                                                    </Border>

                                                    <!--  Right Line Number  -->
                                                    <Border
                                                        Grid.Column="1"
                                                        BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                                                        BorderThickness="0,0,1,0">
                                                        <TextBlock
                                                            Margin="4,0"
                                                            HorizontalAlignment="Right"
                                                            FontFamily="Consolas"
                                                            FontSize="11"
                                                            Foreground="Gray"
                                                            Text="{Binding RightLineNumber}" />
                                                    </Border>

                                                    <!--  Change Indicator  -->
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        HorizontalAlignment="Center"
                                                        FontFamily="Consolas"
                                                        FontSize="12"
                                                        FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Type}" Value="Added">
                                                                        <Setter Property="Text" Value="+" />
                                                                        <Setter Property="Foreground" Value="Green" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Type}" Value="Removed">
                                                                        <Setter Property="Text" Value="-" />
                                                                        <Setter Property="Foreground" Value="Red" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!--  Line Content  -->
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        Margin="8,0,4,0"
                                                        FontFamily="Consolas"
                                                        FontSize="12"
                                                        Text="{Binding Content}"
                                                        TextWrapping="NoWrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!--  Empty State  -->
                                <StackPanel
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ComparisonViewModel.CurrentFileComparison, Converter={x:Static converters:NullToVisibilityConverter.Instance}}">
                                    <materialDesign:PackIcon
                                        Width="64"
                                        Height="64"
                                        HorizontalAlignment="Center"
                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                        Kind="FileCompare"
                                        Opacity="0.3" />
                                    <TextBlock
                                        Margin="0,16,0,0"
                                        HorizontalAlignment="Center"
                                        Opacity="0.5"
                                        Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                        Text="Select a file to view differences" />
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>

                    <!--  Locked Files Browser  -->
                    <Grid
                        Grid.Row="1"
                        Margin="8"
                        Visibility="{Binding IsComparisonVisible, Converter={x:Static converters:InverseBooleanToVisibilityConverter.Instance}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="250" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*" MinWidth="400" />
                        </Grid.ColumnDefinitions>

                        <!--  Locked Files Tree  -->
                        <materialDesign:Card Grid.Column="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  Tree Header  -->
                                <Border Grid.Row="0" Background="{DynamicResource MaterialDesign.Brush.Primary}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="12,8"
                                            FontWeight="Medium"
                                            Foreground="White"
                                            Text="Locked Python Files" />
                                        <Button
                                            Grid.Column="1"
                                            Height="24"
                                            Margin="0,4,4,4"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding ExpandAllLockedFilesCommand}"
                                            Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                                            ToolTip="Expand all folders">
                                            <materialDesign:PackIcon Kind="UnfoldMoreHorizontal" />
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            Height="24"
                                            Margin="4,4,4,4"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding CollapseAllLockedFilesCommand}"
                                            Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                                            ToolTip="Collapse all folders">
                                            <materialDesign:PackIcon Kind="UnfoldLessHorizontal" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!--  Locked Files Tree View  -->
                                <TreeView
                                    x:Name="LockedFilesTreeView"
                                    Grid.Row="1"
                                    ItemsSource="{Binding LockedFiles}"
                                    SelectedItemChanged="LockedFilesTreeView_SelectedItemChanged"
                                    VirtualizingStackPanel.IsVirtualizing="False">
                                    <TreeView.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource MaterialDesignTreeViewItem}" TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <Grid
                                                Margin="2"
                                                Background="Transparent"
                                                ToolTip="{Binding RelativePath}">

                                                <!--  Context Menu for Compare Against Version  -->
                                                <Grid.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" IsEnabled="{Binding IsFolder, Converter={x:Static converters:BooleanInversionConverter.Instance}}">
                                                        <MenuItem Header="Compare against version" ItemsSource="{Binding DataContext.AvailableVersions, Source={x:Reference LockedFilesTreeView}}">
                                                            <MenuItem.ItemContainerStyle>
                                                                <Style BasedOn="{StaticResource MaterialDesignMenuItem}" TargetType="MenuItem">
                                                                    <Setter Property="Header" Value="{Binding}" />
                                                                    <Setter Property="Command" Value="{Binding DataContext.CompareLockedFileAgainstVersionCommand, Source={x:Reference LockedFilesTreeView}}" />
                                                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                                                </Style>
                                                            </MenuItem.ItemContainerStyle>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Grid.ContextMenu>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!--  Icon  -->
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="18"
                                                    Height="18"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Kind" Value="LanguagePython" />
                                                            <Setter Property="Foreground" Value="Gold" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                    <Setter Property="Kind" Value="Folder" />
                                                                    <Setter Property="Foreground" Value="Orange" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>

                                                <!--  File/Folder Name  -->
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Name}">
                                                    <TextBlock.Style>
                                                        <Style BasedOn="{StaticResource MaterialDesignBody2TextBlock}" TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFolder}" Value="False">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>

                                <!--  Empty State  -->
                                <StackPanel
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding LockedFileCount, Converter={x:Static converters:NotZeroToVisibilityConverter.Instance}, ConverterParameter=True}">
                                    <materialDesign:PackIcon
                                        Width="64"
                                        Height="64"
                                        HorizontalAlignment="Center"
                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                        Kind="Lock"
                                        Opacity="0.3" />
                                    <TextBlock
                                        Margin="0,16,0,0"
                                        HorizontalAlignment="Center"
                                        Opacity="0.5"
                                        Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                        Text="No locked files found" />
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <GridSplitter
                            Grid.Column="1"
                            Width="10"
                            HorizontalAlignment="Center"
                            ResizeBehavior="PreviousAndNext" />
                        <!--  Locked File Content Viewer  -->
                        <materialDesign:Card Grid.Column="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  Content Header  -->
                                <Border Grid.Row="0" Background="{DynamicResource MaterialDesign.Brush.Primary}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--  File path and comparison info  -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock
                                                Padding="12,8"
                                                FontWeight="Medium"
                                                Foreground="White"
                                                Text="{Binding SelectedLockedFile.RelativePath, FallbackValue='Select a locked file to view'}" />

                                            <!--  Comparison badge when active  -->
                                            <Border
                                                Margin="0,4"
                                                Padding="8,2"
                                                VerticalAlignment="Center"
                                                Background="#2196F3"
                                                CornerRadius="4"
                                                Visibility="{Binding IsLockedFileComparisonActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="White"
                                                        Text="vs " />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        Text="{Binding LockedFileComparisonVersion}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!--  Diff stats when comparison active  -->
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="0,0,8,0"
                                            Orientation="Horizontal"
                                            Visibility="{Binding IsLockedFileComparisonActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock
                                                Margin="8,0"
                                                VerticalAlignment="Center"
                                                Foreground="LightGreen"
                                                Text="{Binding LockedFileComparisonResult.AddedLines, StringFormat='+{0}'}" />
                                            <TextBlock
                                                Margin="8,0"
                                                VerticalAlignment="Center"
                                                Foreground="LightCoral"
                                                Text="{Binding LockedFileComparisonResult.RemovedLines, StringFormat='-{0}'}" />
                                        </StackPanel>

                                        <!--  Action buttons  -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <!--  Clear comparison button  -->
                                            <Button
                                                Margin="0,0,4,0"
                                                Padding="8"
                                                Command="{Binding ClearLockedFileComparisonCommand}"
                                                Style="{StaticResource MaterialDesignFlatSecondaryDarkButton}"
                                                ToolTip="Exit comparison view"
                                                Visibility="{Binding IsLockedFileComparisonActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <materialDesign:PackIcon Kind="CompareRemove" />
                                            </Button>

                                            <!--  Close file button  -->
                                            <Button
                                                Padding="8"
                                                Command="{Binding ClearSelectedLockedFileCommand}"
                                                Style="{StaticResource MaterialDesignFlatSecondaryDarkButton}"
                                                Visibility="{Binding SelectedLockedFile, Converter={x:Static converters:NotNullToVisibilityConverter.Instance}}">
                                                <materialDesign:PackIcon Kind="Close" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!--  Diff View (when comparison active)  -->
                                <ScrollViewer
                                    Grid.Row="1"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Auto"
                                    Visibility="{Binding IsLockedFileComparisonActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding LockedFileComparisonResult.DiffLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="20">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="45" />
                                                        <ColumnDefinition Width="45" />
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Added">
                                                                    <Setter Property="Background" Value="#1A4CAF50" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Removed">
                                                                    <Setter Property="Background" Value="#1AF44336" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>

                                                    <!--  Left Line Number (Version)  -->
                                                    <Border
                                                        Grid.Column="0"
                                                        BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                                                        BorderThickness="0,0,1,0">
                                                        <TextBlock
                                                            Margin="4,0"
                                                            HorizontalAlignment="Right"
                                                            FontFamily="Consolas"
                                                            FontSize="11"
                                                            Foreground="Gray"
                                                            Text="{Binding LeftLineNumber}" />
                                                    </Border>

                                                    <!--  Right Line Number (Installed)  -->
                                                    <Border
                                                        Grid.Column="1"
                                                        BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                                                        BorderThickness="0,0,1,0">
                                                        <TextBlock
                                                            Margin="4,0"
                                                            HorizontalAlignment="Right"
                                                            FontFamily="Consolas"
                                                            FontSize="11"
                                                            Foreground="Gray"
                                                            Text="{Binding RightLineNumber}" />
                                                    </Border>

                                                    <!--  Change Indicator  -->
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        HorizontalAlignment="Center"
                                                        FontFamily="Consolas"
                                                        FontSize="12"
                                                        FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Type}" Value="Added">
                                                                        <Setter Property="Text" Value="+" />
                                                                        <Setter Property="Foreground" Value="Green" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Type}" Value="Removed">
                                                                        <Setter Property="Text" Value="-" />
                                                                        <Setter Property="Foreground" Value="Red" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!--  Line Content  -->
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        Margin="8,0,4,0"
                                                        FontFamily="Consolas"
                                                        FontSize="12"
                                                        Text="{Binding Content}"
                                                        TextWrapping="NoWrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!--  Plain File Content (when no comparison)  -->
                                <Grid Grid.Row="1">
                                    <Grid.Visibility>
                                        <MultiBinding Converter="{x:Static converters:AllTrueToVisibilityMultiConverter.Instance}">
                                            <Binding Converter="{x:Static converters:NotNullToBooleanConverter.Instance}" Path="SelectedLockedFile" />
                                            <Binding Converter="{x:Static converters:BooleanInversionConverter.Instance}" Path="IsLockedFileComparisonActive" />
                                        </MultiBinding>
                                    </Grid.Visibility>

                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <TextBlock
                                            Margin="4"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Text="{Binding SelectedLockedFileContent}"
                                            TextWrapping="WrapWithOverflow" />
                                    </ScrollViewer>
                                    <Button
                                        Margin="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Command="{Binding OpenLockedFileInExplorerCommand}"
                                        Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                        ToolTip="Open file in File Explorer">
                                        <materialDesign:PackIcon Kind="FolderOpen" />
                                    </Button>
                                </Grid>

                                <!--  Empty State  -->
                                <StackPanel
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding SelectedLockedFile, Converter={x:Static converters:NullToVisibilityConverter.Instance}}">
                                    <materialDesign:PackIcon
                                        Width="64"
                                        Height="64"
                                        HorizontalAlignment="Center"
                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                        Kind="FileLock"
                                        Opacity="0.3" />
                                    <TextBlock
                                        Margin="0,16,0,0"
                                        HorizontalAlignment="Center"
                                        Opacity="0.5"
                                        Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                        Text="Select a file to view content" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        Opacity="0.4"
                                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                        Text="Right-click a file to compare against a version" />
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>

                    <!--  Legend  -->
                    <Border
                        Grid.Row="2"
                        Margin="8"
                        Padding="8"
                        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                        CornerRadius="4"
                        Visibility="{Binding IsComparisonVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Text="Legend:" />
                            <materialDesign:PackIcon
                                Margin="8,0,4,0"
                                VerticalAlignment="Center"
                                Foreground="Green"
                                Kind="Check" />
                            <TextBlock VerticalAlignment="Center" Text="Same" />
                            <materialDesign:PackIcon
                                Margin="16,0,4,0"
                                VerticalAlignment="Center"
                                Foreground="Orange"
                                Kind="AlertCircle" />
                            <TextBlock VerticalAlignment="Center" Text="Different" />
                            <materialDesign:PackIcon
                                Margin="16,0,4,0"
                                VerticalAlignment="Center"
                                Foreground="Red"
                                Kind="MinusCircle" />
                            <TextBlock VerticalAlignment="Center" Text="Source Only" />
                            <materialDesign:PackIcon
                                Margin="16,0,4,0"
                                VerticalAlignment="Center"
                                Foreground="DodgerBlue"
                                Kind="PlusCircle" />
                            <TextBlock VerticalAlignment="Center" Text="Target Only" />
                            <materialDesign:PackIcon
                                Margin="16,0,4,0"
                                VerticalAlignment="Center"
                                Foreground="Gold"
                                Kind="Lock" />
                            <TextBlock VerticalAlignment="Center" Text="Locked" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!--  Backup & Cleanup Tab  -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="BackupRestore" />
                        <TextBlock Text="Backup &amp; Cleanup" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <!--  Backup Instance Selection Card  -->
                            <materialDesign:Card
                                Height="64"
                                Margin="0,0,0,0"
                                Padding="16,8,16,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <ComboBox
                                            Margin="0,0,0,0"
                                            VerticalAlignment="Top"
                                            materialDesign:HintAssist.Hint="Backup"
                                            ItemsSource="{Binding BackupInstances}"
                                            SelectedItem="{Binding SelectedBackup}">
                                            <ComboBox.Style>
                                                <Style BasedOn="{StaticResource MaterialDesignFilledComboBox}" TargetType="ComboBox">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBackupRenaming}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBackupCreating}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                        <TextBox
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Top"
                                            behaviors:FocusSelectAllBehavior.IsFocused="{Binding IsBackupRenaming}"
                                            materialDesign:HintAssist.Hint="Backup Name"
                                            materialDesign:HintAssist.IsFloating="True"
                                            Text="{Binding BackupEditName, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style>
                                                <Style BasedOn="{StaticResource MaterialDesignOutlinedTextBox}" TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBackupRenaming}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBackupCreating}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding ConfirmBackupEditCommand}" />
                                                <KeyBinding Key="Escape" Command="{Binding CancelBackupEditCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </Grid>

                                    <WrapPanel
                                        Grid.Column="1"
                                        Margin="16,0"
                                        VerticalAlignment="Center">
                                        <Button
                                            Margin="0,0,4,0"
                                            Command="{Binding OpenBackupFolderCommand}"
                                            Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                            ToolTip="Open backup folder">
                                            <materialDesign:PackIcon Kind="FolderOpen" />
                                        </Button>
                                        <Button
                                            Margin="4,0"
                                            Command="{Binding StartNewBackupCommand}"
                                            Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                            ToolTip="Create new backup">
                                            <materialDesign:PackIcon Kind="Plus" />
                                        </Button>
                                        <Button
                                            Margin="4,0"
                                            Command="{Binding StartRenameBackupCommand}"
                                            Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                            ToolTip="Rename selected backup">
                                            <materialDesign:PackIcon Kind="RenameBox" />
                                        </Button>
                                        <Button
                                            Margin="4,0,0,0"
                                            Command="{Binding DeleteBackupCommand}"
                                            Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryButton}"
                                            ToolTip="Delete selected backup">
                                            <materialDesign:PackIcon Kind="Delete" />
                                        </Button>
                                    </WrapPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                        Text="{Binding BackupInfoText}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </materialDesign:Card>


                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>


                                <!--  Back up  -->
                                <Button
                                    Height="44"
                                    Margin="8,0,4,8"
                                    Command="{Binding BackupAllFilesCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="ContentCopy" />
                                        <TextBlock FontWeight="Bold" Text="Back up All Files" />
                                    </StackPanel>
                                </Button>

                                <Grid Grid.Row="1" Margin="8,0,4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Height="40"
                                        Command="{Binding BackupJsonCommand}"
                                        Content="Back up JSON"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding RemoveJsonFromBackupCommand}"
                                        Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryDarkButton}"
                                        ToolTip="Remove JSON files from backup">
                                        <materialDesign:PackIcon Kind="Delete" />
                                    </Button>
                                </Grid>
                                <Grid Grid.Row="2" Margin="8,0,4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Height="40"
                                        Command="{Binding BackupRetentionCommand}"
                                        Content="Back up Retention"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding RemoveRetentionFromBackupCommand}"
                                        Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryDarkButton}"
                                        ToolTip="Remove Retention files from backup">
                                        <materialDesign:PackIcon Kind="Delete" />
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="3" Margin="8,0,4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Height="40"
                                        Command="{Binding BackupPythonCommand}"
                                        Content="Back up Python"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding RemovePythonFromBackupCommand}"
                                        Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryDarkButton}"
                                        ToolTip="Remove Python files from backup">
                                        <materialDesign:PackIcon Kind="Delete" />
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="4" Margin="8,0,4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Height="40"
                                        Command="{Binding BackupStubsCommand}"
                                        Content="Back up Page Stubs"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding RemoveStubsFromBackupCommand}"
                                        Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryDarkButton}"
                                        ToolTip="Remove Page Stub files from backup">
                                        <materialDesign:PackIcon Kind="Delete" />
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="5" Margin="8,0,4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Row="5"
                                        Height="40"
                                        Command="{Binding BackupCameraFilesCommand}"
                                        Content="Back up Camera Files"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                    <Button
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding RemoveCameraFilesFromBackupCommand}"
                                        Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryDarkButton}"
                                        ToolTip="Remove Camera files from backup">
                                        <materialDesign:PackIcon Kind="Delete" />
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="6" Margin="8,0,4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Height="40"
                                        Command="{Binding BackupProgramFilesCommand}"
                                        Content="Back up Program"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding RemoveProgramFilesFromBackupCommand}"
                                        Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryDarkButton}"
                                        ToolTip="Remove Program files from backup">
                                        <materialDesign:PackIcon Kind="Delete" />
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="7" Margin="8,0,4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Height="40"
                                        Command="{Binding BackupInspectionFilesCommand}"
                                        Content="Back up Inspection"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding RemoveInspectionFilesFromBackupCommand}"
                                        Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryDarkButton}"
                                        ToolTip="Remove Inspection files from backup">
                                        <materialDesign:PackIcon Kind="Delete" />
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="8" Margin="8,0,4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Height="40"
                                        Command="{Binding BackupDllsCommand}"
                                        Content="Back up DLLs"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding RemoveDllsFromBackupCommand}"
                                        Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryDarkButton}"
                                        ToolTip="Remove DLL files from backup">
                                        <materialDesign:PackIcon Kind="Delete" />
                                    </Button>
                                </Grid>

                                <!--  Copy to Destination  -->
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Height="44"
                                    Margin="8,0,4,8"
                                    Command="{Binding RestoreBackupCommand}"
                                    IsEnabled="{Binding SelectedInstallation.IsBackup, Converter={x:Static converters:BooleanInversionConverter.Instance}}"
                                    Style="{StaticResource MaterialDesignRaisedDarkButton}"
                                    ToolTip="Restore selected backup to target path">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="Restore" />
                                        <TextBlock FontWeight="Bold" Text="Write All to Target" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding CopyJsonToDestinationCommand}"
                                    Content="Copy JSON to Target"
                                    IsEnabled="{Binding SelectedInstallation.IsBackup, Converter={x:Static converters:BooleanInversionConverter.Instance}}"
                                    Style="{StaticResource MaterialDesignFlatLightButton}" />
                                <Button
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding CopyRetentionToDestinationCommand}"
                                    Content="Copy Retention to Target"
                                    IsEnabled="{Binding SelectedInstallation.IsBackup, Converter={x:Static converters:BooleanInversionConverter.Instance}}"
                                    Style="{StaticResource MaterialDesignFlatLightButton}" />
                                <Button
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding CopyPythonToDestinationCommand}"
                                    Content="Copy Python to Target"
                                    IsEnabled="{Binding SelectedInstallation.IsBackup, Converter={x:Static converters:BooleanInversionConverter.Instance}}"
                                    Style="{StaticResource MaterialDesignFlatLightButton}" />
                                <Button
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding CopyStubsToDestinationCommand}"
                                    Content="Copy Stubs to Target"
                                    IsEnabled="{Binding SelectedInstallation.IsBackup, Converter={x:Static converters:BooleanInversionConverter.Instance}}"
                                    Style="{StaticResource MaterialDesignFlatLightButton}" />
                                <Button
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding CopyCameraFilesToDestinationCommand}"
                                    Content="Copy Camera to Target"
                                    IsEnabled="{Binding SelectedInstallation.IsBackup, Converter={x:Static converters:BooleanInversionConverter.Instance}}"
                                    Style="{StaticResource MaterialDesignFlatLightButton}" />
                                <Button
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding CopyProgramFilesToDestinationCommand}"
                                    Content="Copy Program to Target"
                                    IsEnabled="{Binding SelectedInstallation.IsBackup, Converter={x:Static converters:BooleanInversionConverter.Instance}}"
                                    Style="{StaticResource MaterialDesignFlatLightButton}" />
                                <Button
                                    Grid.Row="7"
                                    Grid.Column="1"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding CopyInspectionFilesToDestinationCommand}"
                                    Content="Copy Inspection to Target"
                                    IsEnabled="{Binding SelectedInstallation.IsBackup, Converter={x:Static converters:BooleanInversionConverter.Instance}}"
                                    Style="{StaticResource MaterialDesignFlatLightButton}" />
                                <Button
                                    Grid.Row="8"
                                    Grid.Column="1"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding CopyDllsToDestinationCommand}"
                                    Content="Copy DLLs to Target"
                                    IsEnabled="{Binding SelectedInstallation.IsBackup, Converter={x:Static converters:BooleanInversionConverter.Instance}}"
                                    Style="{StaticResource MaterialDesignFlatLightButton}" />


                                <!--  Delete  -->
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Height="44"
                                    Margin="8,0,4,8"
                                    Command="{Binding DeleteAllCommand}"
                                    IsEnabled="{Binding SelectedInstallation.IsBackup, Converter={x:Static converters:BooleanInversionConverter.Instance}}"
                                    Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                                    ToolTip="Delete all data from target">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="Delete" />
                                        <TextBlock FontWeight="Bold" Text="Delete All Target Data" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding DeleteJsonCommand}"
                                    IsEnabled="{Binding SelectedInstallation.IsBackup, Converter={x:Static converters:BooleanInversionConverter.Instance}}"
                                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="FileRemove" />
                                        <TextBlock Text="Delete JSON in Target" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding DeleteRetentionCommand}"
                                    IsEnabled="{Binding SelectedInstallation.IsBackup, Converter={x:Static converters:BooleanInversionConverter.Instance}}"
                                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="FileRemove" />
                                        <TextBlock Text="Delete Retention in Target" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding DeletePythonCommand}"
                                    IsEnabled="{Binding SelectedInstallation.IsBackup, Converter={x:Static converters:BooleanInversionConverter.Instance}}"
                                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="FileRemove" />
                                        <TextBlock Text="Delete Python in Target" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Row="4"
                                    Grid.Column="2"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding DeletePageStubsCommand}"
                                    IsEnabled="{Binding SelectedInstallation.IsBackup, Converter={x:Static converters:BooleanInversionConverter.Instance}}"
                                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="FileRemove" />
                                        <TextBlock Text="Delete Page Stubs in Target" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!--  Utility Tab  -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="Wrench" />
                        <TextBlock Text="Utilities" />
                    </StackPanel>
                </TabItem.Header>

                <!--  Nested TabControl with Left-Side Tabs  -->
                <TabControl
                    Margin="0,8,0,8"
                    Style="{StaticResource MaterialDesignTabControl}"
                    TabStripPlacement="Left">

                    <!--  Network Tab  -->
                    <TabItem Header="Network">
                        <Grid Margin="8,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Button
                                Grid.Row="0"
                                Height="44"
                                Command="{Binding CheckNetworkCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Kind="Lan" />
                                    <TextBlock Text="Check Network Settings" />
                                </StackPanel>
                            </Button>

                            <ScrollViewer
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding NetworkStatusItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <materialDesign:Card Margin="0,0,0,8" Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!--  Status Icon  -->
                                                    <materialDesign:PackIcon
                                                        Grid.Column="0"
                                                        Width="32"
                                                        Height="32"
                                                        Margin="0,0,16,0"
                                                        VerticalAlignment="Top"
                                                        Foreground="{Binding Status, Converter={x:Static converters:SystemStatusToBrushConverter.Instance}}"
                                                        Kind="{Binding Status, Converter={x:Static converters:SystemStatusToIconConverter.Instance}}" />

                                                    <!--  Status Information  -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="15"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Name}" />
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            FontSize="13"
                                                            Foreground="{Binding Status, Converter={x:Static converters:SystemStatusToBrushConverter.Instance}}"
                                                            Text="{Binding StatusText}" />
                                                        <TextBlock
                                                            Margin="0,4,0,0"
                                                            Opacity="0.7"
                                                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                            Text="{Binding Details}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <!--  Category Badge  -->
                                                    <Border
                                                        Grid.Column="2"
                                                        Margin="8,0,0,0"
                                                        Padding="8,4"
                                                        VerticalAlignment="Top"
                                                        Background="{DynamicResource MaterialDesignDarkBackground}"
                                                        CornerRadius="4"
                                                        Opacity="0.5">
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="Medium"
                                                            Text="{Binding Category}" />
                                                    </Border>
                                                </Grid>
                                            </materialDesign:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!--  Disk Tab  -->
                    <TabItem Header="Disk">
                        <Grid Margin="8,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Button
                                Grid.Row="0"
                                Height="44"
                                Command="{Binding CheckLargeFilesCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Kind="FileFind" />
                                    <TextBlock Text="Check for Large Files" />
                                </StackPanel>
                            </Button>

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                Opacity="0.7"
                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                Text="{Binding UtilityOutput, Mode=OneWay}" />

                            <ScrollViewer
                                Grid.Row="2"
                                Margin="0,8,0,0"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LargeFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <materialDesign:Card Margin="0,0,0,8" Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!--  Open Folder Button  -->
                                                    <Button
                                                        Grid.Column="0"
                                                        Width="32"
                                                        Height="32"
                                                        Margin="0,0,16,0"
                                                        VerticalAlignment="Top"
                                                        Command="{Binding OpenFolderCommand}"
                                                        Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryLightButton}"
                                                        ToolTip="Open folder in File Explorer">
                                                        <materialDesign:PackIcon Kind="FolderOpen" />
                                                    </Button>

                                                    <!--  File Information  -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="15"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding FileName}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTip="{Binding FileName}" />
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            FontSize="13"
                                                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                            Text="{Binding SizeFormatted}" />
                                                        <TextBlock
                                                            Margin="0,4,0,0"
                                                            Opacity="0.7"
                                                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                            Text="{Binding DirectoryPath}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="NoWrap"
                                                            ToolTip="{Binding DirectoryPath}" />
                                                    </StackPanel>
                                                </Grid>
                                            </materialDesign:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!--  System Tab  -->
                    <TabItem Header="System">
                        <Grid Margin="8,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Button
                                Grid.Row="0"
                                Height="44"
                                Command="{Binding CheckSystemCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Kind="Chip" />
                                    <TextBlock Text="Check System Diagnostics" />
                                </StackPanel>
                            </Button>

                            <ScrollViewer
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SystemStatusItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <materialDesign:Card Margin="0,0,0,8" Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!--  Status Icon  -->
                                                    <materialDesign:PackIcon
                                                        Grid.Column="0"
                                                        Width="32"
                                                        Height="32"
                                                        Margin="0,0,16,0"
                                                        VerticalAlignment="Top"
                                                        Foreground="{Binding Status, Converter={x:Static converters:SystemStatusToBrushConverter.Instance}}"
                                                        Kind="{Binding Status, Converter={x:Static converters:SystemStatusToIconConverter.Instance}}" />

                                                    <!--  Status Information  -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="15"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Name}" />
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            FontSize="13"
                                                            Foreground="{Binding Status, Converter={x:Static converters:SystemStatusToBrushConverter.Instance}}"
                                                            Text="{Binding StatusText}" />
                                                        <TextBlock
                                                            Margin="0,4,0,0"
                                                            Opacity="0.7"
                                                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                            Text="{Binding Details}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <!--  Category Badge  -->
                                                    <Border
                                                        Grid.Column="2"
                                                        Margin="8,0,0,0"
                                                        Padding="8,4"
                                                        VerticalAlignment="Top"
                                                        Background="{DynamicResource MaterialDesignDarkBackground}"
                                                        CornerRadius="4"
                                                        Opacity="0.5">
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="Medium"
                                                            Text="{Binding Category}" />
                                                    </Border>
                                                </Grid>
                                            </materialDesign:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!--  Event Logs Tab  -->
                    <TabItem Header="Event Logs">
                        <Grid Margin="8,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Button
                                Grid.Row="0"
                                Height="44"
                                Command="{Binding SearchEventLogsCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Kind="FileDocumentMultiple" />
                                    <TextBlock Text="Search Event Viewer for PathMasterX" />
                                </StackPanel>
                            </Button>

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                Opacity="0.7"
                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                Text="{Binding EventSearchStatus, Mode=OneWay}" />

                            <ScrollViewer
                                Grid.Row="2"
                                Margin="0,8,0,0"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding EventLogItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <materialDesign:Card Margin="0,0,0,8" Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!--  Level Icon  -->
                                                    <materialDesign:PackIcon
                                                        Grid.Column="0"
                                                        Width="32"
                                                        Height="32"
                                                        Margin="0,0,16,0"
                                                        VerticalAlignment="Top"
                                                        Foreground="{Binding Level, Converter={x:Static converters:EventLogLevelToBrushConverter.Instance}}"
                                                        Kind="{Binding Level, Converter={x:Static converters:EventLogLevelToIconConverter.Instance}}" />

                                                    <!--  Event Information  -->
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Grid.ColumnSpan="2"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="15"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Name}" />
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            FontSize="13"
                                                            Foreground="{Binding Level, Converter={x:Static converters:EventLogLevelToBrushConverter.Instance}}"
                                                            Text="{Binding StatusText}" />

                                                        <Expander Header="Details">

                                                            <TextBox
                                                                Margin="0,4,0,0"
                                                                FontFamily="Consolas"
                                                                FontSize="12"
                                                                IsReadOnly="True"
                                                                Opacity="0.7"
                                                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                                Text="{Binding Details}"
                                                                TextWrapping="{Binding Details, Converter={x:Static converters:NewlineToTextWrappingConverter.Instance}}" />
                                                        </Expander>
                                                    </StackPanel>

                                                    <!--  Category Badge (Log Name)  -->
                                                    <Border
                                                        Grid.Column="2"
                                                        Margin="8,0,0,0"
                                                        Padding="8,4"
                                                        VerticalAlignment="Top"
                                                        Background="{DynamicResource MaterialDesignDarkBackground}"
                                                        CornerRadius="4"
                                                        Opacity="0.5">
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="Medium"
                                                            Text="{Binding Category}" />
                                                    </Border>
                                                </Grid>
                                            </materialDesign:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!--  PMX Launcher Tab  -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="RocketLaunch" />
                        <TextBlock Text="PMX Launcher" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">

                        <!--  Application Section  -->
                        <materialDesign:Card Margin="0,0,0,16" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="Offline Mode"
                                        IsChecked="{Binding OfflineMode}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="Auto-Accept Start Prompts (OEM Required)"
                                        IsChecked="{Binding AutoAdvance}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="Software Only Rendering"
                                        IsChecked="{Binding SoftwareRendering}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />
                                    <CheckBox
                                        Margin="0,0,0,16"
                                        Content="Free Window - Movable &amp; Resizable"
                                        IsChecked="{Binding FreeWindow}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Grid.Column="0"
                                            materialDesign:HintAssist.Hint="Start Page"
                                            materialDesign:HintAssist.IsFloating="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding StartPage, UpdateSourceTrigger=PropertyChanged}" />
                                        <ToggleButton
                                            x:Name="PageSelectionButton"
                                            Grid.Column="1"
                                            Height="40"
                                            Margin="8,0,0,0"
                                            Padding="16,4"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            ToolTip="Select page from installation">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="BookOpenPageVariant" />
                                                <materialDesign:PackIcon Kind="MenuDown" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <Popup
                                            AllowsTransparency="True"
                                            IsOpen="{Binding IsChecked, ElementName=PageSelectionButton, Mode=TwoWay}"
                                            Placement="Bottom"
                                            PlacementTarget="{Binding ElementName=PageSelectionButton}"
                                            StaysOpen="False">
                                            <materialDesign:Card
                                                Margin="0"
                                                Padding="0"
                                                Style="{DynamicResource MaterialDesignElevatedCard}">
                                                <Grid Margin="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <materialDesign:ColorZone Mode="PrimaryDark">

                                                        <TextBlock
                                                            Margin="16,8"
                                                            FontWeight="SemiBold"
                                                            Style="{DynamicResource MaterialDesignTextBlock}"
                                                            Text="Select a Page:" />
                                                    </materialDesign:ColorZone>
                                                    <ListBox
                                                        Grid.Row="1"
                                                        Width="350"
                                                        MaxHeight="400"
                                                        ItemsSource="{Binding AvailablePages}"
                                                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>

                                                                <StackPanel Grid.Column="1" Margin="8,4">
                                                                    <TextBlock
                                                                        Opacity="0.4"
                                                                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                        Text="{Binding UIPath}"
                                                                        TextWrapping="Wrap" />
                                                                    <TextBlock
                                                                        Margin="4,0,0,0"
                                                                        FontWeight="SemiBold"
                                                                        Text="{Binding Name}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                        <ListBox.ItemContainerStyle>
                                                            <Style BasedOn="{StaticResource MaterialDesignListBoxItem}" TargetType="ListBoxItem">
                                                                <EventSetter Event="MouseLeftButtonUp" Handler="PageListBoxItem_Click" />
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                    </ListBox>
                                                </Grid>
                                            </materialDesign:Card>
                                        </Popup>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Grid.Column="0"
                                            materialDesign:HintAssist.Hint="Width"
                                            materialDesign:HintAssist.IsFloating="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding WindowWidth, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="16,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                            Text="×" />
                                        <TextBox
                                            Grid.Column="2"
                                            materialDesign:HintAssist.Hint="Height"
                                            materialDesign:HintAssist.IsFloating="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding WindowHeight, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Grid.Column="0"
                                            materialDesign:HintAssist.Hint="X Position"
                                            materialDesign:HintAssist.IsFloating="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding WindowX, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="16,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                            Text="," />
                                        <TextBox
                                            Grid.Column="2"
                                            materialDesign:HintAssist.Hint="Y Position"
                                            materialDesign:HintAssist.IsFloating="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding WindowY, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="Vision Debug - Verbose Errors"
                                        IsChecked="{Binding VisionDebug}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />
                                    <CheckBox
                                        Content="Vision Trace - External Tracing"
                                        IsChecked="{Binding VisionTrace}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />

                                    <Separator Margin="0,10" />

                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="Record On Startup"
                                        IsChecked="{Binding RecordOnStartup}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="Record High Quality"
                                        IsChecked="{Binding RecordHighQuality}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="Record High Framerate - 30 FPS"
                                        IsChecked="{Binding RecordHighFramerate}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="Record Microphone"
                                        IsChecked="{Binding RecordMicrophone}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />
                                    <CheckBox
                                        Margin="0,0,0,16"
                                        Content="Record Webcam"
                                        IsChecked="{Binding RecordWebcam}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />

                                    <TextBox
                                        Width="200"
                                        HorizontalAlignment="Left"
                                        materialDesign:HintAssist.Hint="Max Recording Segments"
                                        materialDesign:HintAssist.IsFloating="True"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding MaxSegments, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="Maximum number of consecutive 30-minute segments" />
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <Button
                            Height="56"
                            Command="{Binding LaunchPmxCommand}"
                            FontSize="16"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Kind="RocketLaunch" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="Launch PMX" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!--  Status Bar  -->
        <materialDesign:ColorZone
            Grid.Row="2"
            Padding="16,12"
            Mode="SecondaryDark">
            <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}" Text="{Binding StatusMessage}" />
        </materialDesign:ColorZone>
    </Grid>
</Window>
