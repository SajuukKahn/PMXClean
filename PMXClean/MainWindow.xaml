
<Window
    x:Class="PMXClean.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PMXClean"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PMXClean.ViewModels"
    Title="PathMaster X Utility Tool"
    Width="1000"
    Height="700"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header with Path Selection  -->
        <materialDesign:ColorZone
            Grid.Row="0"
            Padding="16"
            Mode="SecondaryDark">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    Margin="0,0,16,0"
                    materialDesign:HintAssist.Hint="Select installation"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding Installations}"
                    SelectedItem="{Binding SelectedInstallation}"
                    Style="{StaticResource MaterialDesignFilledComboBox}" />
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding OpenTargetFolderCommand}"
                        Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                        ToolTip="Open target installation folder in File Explorer">
                        <materialDesign:PackIcon Kind="FolderOpen" />
                    </Button>
                    <Button
                        Command="{Binding RefreshPathsCommand}"
                        Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                        ToolTip="Refresh installation paths">
                        <materialDesign:PackIcon Kind="Refresh" />
                    </Button>
                </WrapPanel>

                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource MaterialDesignLabelSmallTextBlock}"
                    Text="{Binding FileVersionText}" />
            </Grid>
        </materialDesign:ColorZone>

        <!--  Main Content - Tabs  -->
        <TabControl
            Grid.Row="1"
            Margin="0,0,0,0"
            Style="{StaticResource MaterialDesignTabControl}">

            <!--  Compare Python Tab  -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="CodeBraces" />
                        <TextBlock Text="Compare Python" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!--  Version Selection Card  -->
                        <materialDesign:Card Margin="0,0,0,24" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Height="46"
                                    Margin="0,0,16,0"
                                    materialDesign:HintAssist.Hint="Source Version"
                                    materialDesign:HintAssist.IsFloating="True"
                                    ItemsSource="{Binding AvailableVersions}"
                                    SelectedItem="{Binding SelectedVersion}"
                                    Style="{StaticResource MaterialDesignFilledComboBox}" />
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Command="{Binding AutoMatchVersionCommand}"
                                    Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                    ToolTip="Auto-select version matching the target installation">
                                    <materialDesign:PackIcon Kind="AutoFix" />
                                </Button>

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,12,0,0"
                                    Opacity="0.7"
                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                    Text="{Binding VersionInfoText}" />
                            </Grid>
                        </materialDesign:Card>

                        <Button
                            Height="48"
                            Command="{Binding CompareWithWinMergeCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="Compare" />
                                <TextBlock VerticalAlignment="Center" Text="Compare with WinMerge" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--  Backup & Cleanup Tab  -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="BackupRestore" />
                        <TextBlock Text="Backup &amp; Cleanup" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <!--  Backup Instance Selection Card  -->
                            <materialDesign:Card
                                Height="84"
                                Margin="0,0,0,0"
                                Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <ComboBox
                                            Height="46"
                                            Margin="0,0,8,0"
                                            materialDesign:HintAssist.Hint="Backup"
                                            ItemsSource="{Binding BackupInstances}"
                                            SelectedItem="{Binding SelectedBackup}">
                                            <ComboBox.Style>
                                                <Style BasedOn="{StaticResource MaterialDesignFilledComboBox}" TargetType="ComboBox">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBackupRenaming}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBackupCreating}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                        <TextBox
                                            Margin="0,0,8,0"
                                            materialDesign:HintAssist.Hint="Backup Name"
                                            materialDesign:HintAssist.IsFloating="True"
                                            Text="{Binding BackupEditName, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style>
                                                <Style BasedOn="{StaticResource MaterialDesignOutlinedTextBox}" TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBackupRenaming}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBackupCreating}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding ConfirmBackupEditCommand}" />
                                                <KeyBinding Key="Escape" Command="{Binding CancelBackupEditCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </Grid>

                                    <WrapPanel
                                        Grid.Column="1"
                                        Margin="16,0"
                                        VerticalAlignment="Center">
                                        <Button
                                            Margin="0,0,4,0"
                                            Command="{Binding StartNewBackupCommand}"
                                            Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                            ToolTip="Create new backup">
                                            <materialDesign:PackIcon Kind="Plus" />
                                        </Button>
                                        <Button
                                            Margin="4,0"
                                            Command="{Binding StartRenameBackupCommand}"
                                            Style="{StaticResource MaterialDesignFloatingActionMiniDarkButton}"
                                            ToolTip="Rename selected backup">
                                            <materialDesign:PackIcon Kind="RenameBox" />
                                        </Button>
                                        <Button
                                            Margin="4,0,0,0"
                                            Command="{Binding DeleteBackupCommand}"
                                            Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryButton}"
                                            ToolTip="Delete selected backup">
                                            <materialDesign:PackIcon Kind="Delete" />
                                        </Button>
                                    </WrapPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                        Text="{Binding BackupInfoText}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </materialDesign:Card>

                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>


                                <!--  Back up  -->
                                <Button
                                    Height="44"
                                    Margin="8,0,4,8"
                                    Command="{Binding BackupAllFilesCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="ContentCopy" />
                                        <TextBlock FontWeight="Bold" Text="Back up All Files" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Row="1"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding BackupJsonCommand}"
                                    Content="Back up JSON"
                                    Style="{StaticResource MaterialDesignFlatButton}" />
                                <Button
                                    Grid.Row="2"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding BackupRetentionCommand}"
                                    Content="Back up Retention"
                                    Style="{StaticResource MaterialDesignFlatButton}" />
                                <Button
                                    Grid.Row="3"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding BackupPythonCommand}"
                                    Content="Back up Python"
                                    Style="{StaticResource MaterialDesignFlatButton}" />
                                <Button
                                    Grid.Row="4"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding BackupStubsCommand}"
                                    Content="Back up Page Stubs"
                                    Style="{StaticResource MaterialDesignFlatButton}" />

                                <Button
                                    Grid.Row="5"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding BackupCameraFilesCommand}"
                                    Content="Back up Camera Files"
                                    Style="{StaticResource MaterialDesignFlatButton}" />

                                <Button
                                    Grid.Row="6"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding BackupDllsCommand}"
                                    Content="Back up DLLs"
                                    Style="{StaticResource MaterialDesignFlatButton}" />


                                <!--  Copy to Destination  -->
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Height="44"
                                    Margin="8,0,4,8"
                                    Command="{Binding RestoreBackupCommand}"
                                    Style="{StaticResource MaterialDesignRaisedDarkButton}"
                                    ToolTip="Restore selected backup to target path">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="Restore" />
                                        <TextBlock FontWeight="Bold" Text="Write All to Target" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding CopyJsonToDestinationCommand}"
                                    Content="Copy JSON to Target"
                                    Style="{StaticResource MaterialDesignFlatLightButton}" />
                                <Button
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding CopyRetentionToDestinationCommand}"
                                    Content="Copy Retention to Target"
                                    Style="{StaticResource MaterialDesignFlatLightButton}" />
                                <Button
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding CopyPythonToDestinationCommand}"
                                    Content="Copy Python to Target"
                                    Style="{StaticResource MaterialDesignFlatLightButton}" />
                                <Button
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding CopyStubsToDestinationCommand}"
                                    Content="Copy Stubs to Target"
                                    Style="{StaticResource MaterialDesignFlatLightButton}" />
                                <Button
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding CopyCameraFilesToDestinationCommand}"
                                    Content="Copy Camera to Target"
                                    Style="{StaticResource MaterialDesignFlatLightButton}" />
                                <Button
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding CopyDllsToDestinationCommand}"
                                    Content="Copy DLLs to Target"
                                    Style="{StaticResource MaterialDesignFlatLightButton}" />


                                <!--  Delete  -->
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Height="44"
                                    Margin="8,0,4,8"
                                    Command="{Binding DeleteAllCommand}"
                                    Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                                    ToolTip="Delete all data from target">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="Delete" />
                                        <TextBlock FontWeight="Bold" Text="Delete All" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding DeleteJsonCommand}"
                                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="FileRemove" />
                                        <TextBlock Text="Delete JSON" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding DeleteRetentionCommand}"
                                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="FileRemove" />
                                        <TextBlock Text="Delete Retention" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding DeletePythonCommand}"
                                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="FileRemove" />
                                        <TextBlock Text="Delete Python" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Row="4"
                                    Grid.Column="2"
                                    Height="40"
                                    Margin="8,0,4,8"
                                    Command="{Binding DeletePageStubsCommand}"
                                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="FileRemove" />
                                        <TextBlock Text="Delete Page Stubs" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!--  Utility Tab  -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="Wrench" />
                        <TextBlock Text="Utility" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Button
                            Grid.Column="0"
                            Height="44"
                            Margin="0,0,0,0"
                            Command="{Binding CheckNetworkCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="Lan" />
                                <TextBlock Text="Check Network Settings" />
                            </StackPanel>
                        </Button>

                        <materialDesign:Card
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,8,0,0"
                            Padding="4">
                            <TextBox
                                MinHeight="200"
                                VerticalContentAlignment="Top"
                                AcceptsReturn="True"
                                BorderThickness="0"
                                FontFamily="Cascadia Code, Consolas, Courier New"
                                IsReadOnly="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding NetworkUtilityOutput, Mode=OneWay}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                        </materialDesign:Card>

                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            Height="44"
                            Command="{Binding CheckLargeFilesCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="FileFind" />
                                <TextBlock Text="Check for Large Files" />
                            </StackPanel>
                        </Button>

                        <materialDesign:Card
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,8,0,0"
                            Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Margin="0,0,0,8"
                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                    Text="{Binding UtilityOutput, Mode=OneWay}"
                                    TextWrapping="Wrap" />

                                <ListView
                                    Grid.Row="1"
                                    Width="445"
                                    MinHeight="150"
                                    MaxHeight="400"
                                    ItemsSource="{Binding LargeFiles}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{Binding FileName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Width="240"
                                                        HorizontalAlignment="Left"
                                                        Opacity="0.7"
                                                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                        Text="{Binding DirectoryPath}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        Margin="8,0"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding SizeFormatted}" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Command="{Binding OpenFolderCommand}"
                                                        Style="{StaticResource MaterialDesignPaperSecondaryButton}"
                                                        ToolTip="Open folder in File Explorer">
                                                        <materialDesign:PackIcon Kind="FolderOpen" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </materialDesign:Card>

                    </Grid>
                </Grid>
            </TabItem>

            <!--  PMX Launcher Tab  -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="RocketLaunch" />
                        <TextBlock Text="PMX Launcher" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">

                        <!--  Application Section  -->
                        <materialDesign:Card Margin="0,0,0,16" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="Offline Mode"
                                        IsChecked="{Binding OfflineMode}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="Auto-Accept Start Prompts (OEM Required)"
                                        IsChecked="{Binding AutoAdvance}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="Software Only Rendering"
                                        IsChecked="{Binding SoftwareRendering}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />
                                    <CheckBox
                                        Margin="0,0,0,16"
                                        Content="Free Window - Movable &amp; Resizable"
                                        IsChecked="{Binding FreeWindow}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />

                                    <TextBox
                                        Margin="0,0,0,16"
                                        materialDesign:HintAssist.Hint="Start Page"
                                        materialDesign:HintAssist.IsFloating="True"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding StartPage, UpdateSourceTrigger=PropertyChanged}" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Grid.Column="0"
                                            materialDesign:HintAssist.Hint="Width"
                                            materialDesign:HintAssist.IsFloating="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding WindowWidth, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="16,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                            Text="×" />
                                        <TextBox
                                            Grid.Column="2"
                                            materialDesign:HintAssist.Hint="Height"
                                            materialDesign:HintAssist.IsFloating="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding WindowHeight, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Grid.Column="0"
                                            materialDesign:HintAssist.Hint="X Position"
                                            materialDesign:HintAssist.IsFloating="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding WindowX, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="16,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                            Text="," />
                                        <TextBox
                                            Grid.Column="2"
                                            materialDesign:HintAssist.Hint="Y Position"
                                            materialDesign:HintAssist.IsFloating="True"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding WindowY, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="Vision Debug - Verbose Errors"
                                        IsChecked="{Binding VisionDebug}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />
                                    <CheckBox
                                        Content="Vision Trace - External Tracing"
                                        IsChecked="{Binding VisionTrace}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />

                                    <Separator Margin="0,10" />

                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="Record On Startup"
                                        IsChecked="{Binding RecordOnStartup}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="Record High Quality"
                                        IsChecked="{Binding RecordHighQuality}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="Record High Framerate - 30 FPS"
                                        IsChecked="{Binding RecordHighFramerate}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="Record Microphone"
                                        IsChecked="{Binding RecordMicrophone}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />
                                    <CheckBox
                                        Margin="0,0,0,16"
                                        Content="Record Webcam"
                                        IsChecked="{Binding RecordWebcam}"
                                        Style="{StaticResource MaterialDesignCheckBox}" />

                                    <TextBox
                                        Width="200"
                                        HorizontalAlignment="Left"
                                        materialDesign:HintAssist.Hint="Max Recording Segments"
                                        materialDesign:HintAssist.IsFloating="True"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding MaxSegments, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="Maximum number of consecutive 30-minute segments" />
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <Button
                            Height="56"
                            Command="{Binding LaunchPmxCommand}"
                            FontSize="16"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Kind="RocketLaunch" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="Launch PMX" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!--  Status Bar  -->
        <materialDesign:ColorZone
            Grid.Row="2"
            Padding="16,12"
            Mode="SecondaryDark">
            <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}" Text="{Binding StatusMessage}" />
        </materialDesign:ColorZone>
    </Grid>
</Window>
