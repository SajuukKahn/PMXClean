 <Window x:Class="PMXClean.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PMXClean"
        mc:Ignorable="d"
        Title="PMX Utility Tool" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Path Selection -->
        <Border Grid.Row="0" Background="#FF2D2D30" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Target Path:" 
                           Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="TargetPathComboBox" 
                         VerticalAlignment="Center"
                         Padding="5" Margin="0,0,10,0"
                         SelectionChanged="TargetPathComboBox_SelectionChanged"
                         Height="32"/>
                <Button Grid.Row="0" Grid.Column="2" Content="📁 Open Folder" 
                        Click="OpenTargetFolder_Click" Padding="10,5"
                        Width="110" Margin="0,0,5,0"
                        ToolTip="Open target folder in File Explorer"/>
                <Button Grid.Row="0" Grid.Column="3" Content="Refresh Paths" 
                        Click="RefreshPaths_Click" Padding="10,5"
                        Width="110"/>

                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                           x:Name="FileVersionTextBlock"
                           Foreground="#FF90CAF9" 
                           FontSize="11"
                           FontStyle="Italic"
                           Margin="0,5,0,0"
                           VerticalAlignment="Center"
                           Text=""/>
            </Grid>
        </Border>

        <!-- Main Content - Tabs -->
        <TabControl Grid.Row="1" Margin="10">
            <!-- Compare Python Tab -->
            <TabItem Header="Compare Python">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Compare Python Files" 
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <StackPanel Grid.Row="1">
                        <Button Content="Compare Installed" 
                                Click="CompareInstalled_Click" 
                                Padding="10" Height="40"/>
                        <Button Content="Pull Fresh Master" 
                                Click="PullFreshMaster_Click" 
                                Padding="10" Height="40" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Backup Tab -->
            <!-- Backup & Cleanup Tab -->
            <TabItem Header="Backup &amp; Cleanup">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Backup Column -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Backup Manager" 
                                   FontSize="18" FontWeight="Bold" 
                                   Foreground="#FF4CAF50"
                                   Margin="0,0,0,10"/>

                        <!-- Backup Selection and Management -->
                        <Border Grid.Row="1" BorderBrush="#FF2D2D30" BorderThickness="1" Padding="10" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Select Backup Instance:" FontWeight="Bold" Margin="0,0,0,5"/>
                                <Grid>
                                    <ComboBox x:Name="BackupComboBox" 
                                              SelectionChanged="BackupComboBox_SelectionChanged"
                                              Height="30" Margin="0,0,0,10"/>
                                    <TextBox x:Name="BackupRenameTextBox" 
                                             Height="30" Margin="0,0,0,10"
                                             Padding="5"
                                             Visibility="Collapsed"
                                             KeyDown="BackupRenameTextBox_KeyDown"
                                             LostFocus="BackupRenameTextBox_LostFocus"/>
                                    <TextBox x:Name="BackupNewNameTextBox" 
                                             Height="30" Margin="0,0,0,10"
                                             Padding="5"
                                             Visibility="Collapsed"
                                             KeyDown="BackupNewNameTextBox_KeyDown"
                                             LostFocus="BackupNewNameTextBox_LostFocus"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="New..." 
                                            Click="NewBackupInstance_Click" 
                                            Padding="5" Height="30"
                                            Background="#FF4CAF50"/>
                                    <Button Grid.Column="2" Content="Rename..." 
                                            Click="RenameBackup_Click" 
                                            Padding="5" Height="30"/>
                                    <Button Grid.Column="4" Content="Delete" 
                                            Click="DeleteBackupInstance_Click" 
                                            Padding="5" Height="30"
                                            Background="#FFCC4444"/>
                                </Grid>

                                <TextBlock x:Name="BackupInfoTextBlock" 
                                           Text="No backup selected" 
                                           Margin="0,10,0,0" 
                                           FontStyle="Italic"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Backup Operations -->
                        <TextBlock Grid.Row="2" Text="Backup Operations" 
                                   FontWeight="Bold" Margin="0,0,0,10"/>

                        <StackPanel Grid.Row="3">
                            <Button Content="Copy All Files" 
                                    Click="BackupAll_Click" 
                                    Padding="10" Height="40"
                                    Background="#FF4CAF50"
                                    FontWeight="Bold"/>
                            <Button Content="Copy JSON" 
                                    Click="BackupJson_Click" 
                                    Padding="10" Height="40" Margin="0,10,0,0"/>
                            <Button Content="Copy Retention" 
                                    Click="BackupRetention_Click" 
                                    Padding="10" Height="40" Margin="0,10,0,0"/>
                            <Button Content="Copy Python" 
                                    Click="BackupPython_Click" 
                                    Padding="10" Height="40" Margin="0,10,0,0"/>
                            <Button Content="Copy DLLs" 
                                    Click="BackupDlls_Click" 
                                    Padding="10" Height="40" Margin="0,10,0,0"/>
                            <Button Content="Copy Page Stubs" 
                                    Click="BackupStubs_Click" 
                                    Padding="10" Height="40" Margin="0,10,0,0"/>
                            <Separator Margin="0,15"/>
                            <Button Content="Restore to Target" 
                                    Click="OverwriteTarget_Click" 
                                    Padding="10" Height="40" 
                                    Background="#FFCC4444" 
                                    FontWeight="Bold"
                                    ToolTip="Restore selected backup to target path"/>
                        </StackPanel>
                    </Grid>

                    <!-- Vertical Separator -->
                    <Border Grid.Column="1" Background="#FF2D2D30" Margin="10,0"/>

                    <!-- Cleanup Column -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Clean Up Files" 
                                   FontSize="18" FontWeight="Bold" 
                                   Foreground="#FFF44336"
                                   Margin="0,0,0,20"/>

                        <StackPanel Grid.Row="1">
                            <Button Content="Delete JSON" 
                                    Click="DeleteJson_Click" 
                                    Padding="10" Height="40" Background="#FFCC4444"/>
                            <Button Content="Delete Retention" 
                                    Click="DeleteRetention_Click" 
                                    Padding="10" Height="40" Background="#FFCC4444" Margin="0,10,0,0"/>
                            <Button Content="Delete Python" 
                                    Click="DeletePython_Click" 
                                    Padding="10" Height="40" Background="#FFCC4444" Margin="0,10,0,0"/>
                            <Button Content="Delete Page Stubs" 
                                    Click="DeletePageStubs_Click" 
                                    Padding="10" Height="40" Background="#FFCC4444" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Utility Tab -->
            <TabItem Header="Utility">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Utilities" 
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <StackPanel Grid.Row="1">
                        <Button Content="Check Network Settings" 
                                Click="NetworkCheck_Click" 
                                Padding="10" Height="40"/>
                        <Button Content="Check for Large Files" 
                                Click="CheckLargeFiles_Click" 
                                Padding="10" Height="40" Margin="0,10,0,0"/>
                    </StackPanel>

                    <TextBox Grid.Row="2" x:Name="UtilityOutputTextBox" 
                             IsReadOnly="True" 
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             Margin="0,20,0,0"
                             Padding="5"/>
                </Grid>
            </TabItem>

            <!-- PMX Launcher Tab -->
            <TabItem Header="PMX Launcher">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="PMX Launcher" 
                                   FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                        <StackPanel Grid.Row="1">
                            <!-- Application Section -->
                            <Border BorderBrush="#FF2D2D30" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Application" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                                    <CheckBox x:Name="OfflineCheckBox" Content="Offline Mode (-offline)" Margin="0,3"/>
                                    <CheckBox x:Name="AutoAdvanceCheckBox" Content="Auto-Accept Prompts (-autoAdvance)" Margin="0,3"/>
                                    <CheckBox x:Name="SoftwareRenderingCheckBox" Content="Software Only Rendering (-software)" Margin="0,3"/>
                                    <CheckBox x:Name="FreeWindowCheckBox" Content="Free Window - Movable &amp; Resizable (-freeWindow)" Margin="0,3"/>

                                    <Grid Margin="0,8,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Start Page:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="StartPageTextBox" Padding="5" 
                                                 ToolTip="Page reference name to navigate to on startup (-page:[name])"/>
                                    </Grid>

                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Window Size:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="WindowWidthTextBox" Padding="5" 
                                                 ToolTip="Width in pixels"/>
                                        <TextBlock Grid.Column="2" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="3" x:Name="WindowHeightTextBox" Padding="5" 
                                                 ToolTip="Height in pixels (-size:[width]:[height])"/>
                                    </Grid>

                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Window Position:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="WindowXTextBox" Padding="5" 
                                                 ToolTip="X position in pixels"/>
                                        <TextBlock Grid.Column="2" Text="," HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="3" x:Name="WindowYTextBox" Padding="5" 
                                                 ToolTip="Y position in pixels (-position:[X]:[Y])"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Vision Section -->
                            <Border BorderBrush="#FF2D2D30" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Vision" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="VisionDebugCheckBox" Content="Vision Debug - Verbose Error Reporting (-visionDebug)" Margin="0,3"/>
                                    <CheckBox x:Name="VisionTraceCheckBox" Content="Vision Trace - External Vision Tracing (-visionTrace)" Margin="0,3"/>
                                </StackPanel>
                            </Border>

                            <!-- Screen Recording Section -->
                            <Border BorderBrush="#FF2D2D30" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Screen Recording" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="RecordOnStartupCheckBox" Content="Record On Startup (-recordOnStartup)" Margin="0,3"/>
                                    <CheckBox x:Name="RecordHighQualityCheckBox" Content="Record High Quality (-recordHighQuality)" Margin="0,3"/>
                                    <CheckBox x:Name="RecordHighFramerateCheckBox" Content="Record High Framerate - 30 FPS (-recordHighFramerate)" Margin="0,3"/>
                                    <CheckBox x:Name="RecordMicrophoneCheckBox" Content="Record Microphone (-recordMicrophone)" Margin="0,3"/>
                                    <CheckBox x:Name="RecordWebcamCheckBox" Content="Record Webcam (-recordWebcam)" Margin="0,3"/>

                                    <Grid Margin="0,8,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Max Recording Segments:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="MaxSegmentsTextBox" Padding="5" 
                                                 ToolTip="Maximum number of consecutive 30-minute segments (-recordMaxSegments:[maxSegments])"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Button Grid.Row="2" Content="Launch PMX" 
                                Click="LaunchPMX_Click" 
                                Padding="10" Height="50" 
                                FontSize="16" FontWeight="Bold"
                                Background="#FF4CAF50"
                                Margin="0,10,0,0"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#FF2D2D30" Padding="10">
            <TextBlock x:Name="StatusTextBlock" 
                       Text="Ready" 
                       Foreground="White"/>
        </Border>
    </Grid>
</Window>
